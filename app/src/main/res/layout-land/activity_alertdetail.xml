<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <LinearLayout
        android:id="@+id/detail_header_layout"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/listPreferredItemHeight"
        android:orientation="horizontal"
        android:padding="8dp"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/detail_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:layout_marginStart="0dp"
            android:contentDescription="@string/icon"
            android:src="@drawable/nws_logo" />

        <TextView
            android:id="@+id/detail_event"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:shadowColor="@color/alert_detail_title_shadow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            android:text="@string/detail_retrieval"
            android:textColor="@color/alert_detail_title_text"
            android:textSize="22sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <ScrollView
            android:id="@+id/detail_main_scroller"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="16dp"
                        android:paddingStart="0dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="?attr/colorOutline">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="16dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginEnd="12dp"
                                    android:src="@drawable/ic_location_pin"
                                    app:tint="?attr/colorPrimary"
                                    android:contentDescription="@null" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/detail_target"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:paddingBottom="2dp"
                                        tools:text="Where: Dane, WI" />

                                    <TextView
                                        android:id="@+id/detail_expires"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="13sp"
                                        tools:text="Expires: Saturday, April 25, 2026 3:30 PM" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/detail_description_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_description"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:paddingBottom="8dp" />

                        <TextView
                            android:id="@+id/detail_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textIsSelectable="true"
                            android:typeface="monospace"
                            android:paddingBottom="16dp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Metadata parameters -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/detail_params_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="?attr/colorOutline"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <LinearLayout
                                    android:id="@+id/layout_tornado_detection"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingBottom="8dp"
                                    android:visibility="gone"
                                    tools:visibility="visible">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/tornado"
                                        android:paddingEnd="8dp"
                                        android:paddingStart="0dp"
                                        android:contentDescription="@null"/>
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/detail_tornado_detection"
                                        android:textStyle="bold"/>
                                    <TextView
                                        android:id="@+id/detail_tornado_detection"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textStyle="bold"/>
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/group_wind"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="top"
                                    android:paddingBottom="8dp"
                                    android:visibility="gone"
                                    tools:visibility="visible">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/windy"
                                        android:paddingEnd="8dp"
                                        android:paddingStart="0dp"
                                        android:contentDescription="@null"/>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">
                                        <LinearLayout
                                            android:id="@+id/layout_wind_gust"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="horizontal"
                                            android:visibility="gone"
                                            tools:visibility="visible">
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="@string/detail_wind_gust"
                                                android:textStyle="bold"/>
                                            <TextView
                                                android:id="@+id/detail_wind_gust"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textStyle="bold"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:id="@+id/layout_wind_threat"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="horizontal"
                                            android:visibility="gone"
                                            tools:visibility="visible">
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="@string/detail_source"
                                                android:textStyle="bold"/>
                                            <TextView
                                                android:id="@+id/detail_wind_threat"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textStyle="bold"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/group_hail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="top"
                                    android:paddingBottom="8dp"
                                    android:visibility="gone"
                                    tools:visibility="visible">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ice"
                                        android:paddingEnd="8dp"
                                        android:paddingStart="0dp"
                                        android:contentDescription="@null"/>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">
                                        <LinearLayout
                                            android:id="@+id/layout_hail_size"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="horizontal"
                                            android:visibility="gone"
                                            tools:visibility="visible">
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="@string/detail_hail_size"
                                                android:textStyle="bold"/>
                                            <TextView
                                                android:id="@+id/detail_hail_size"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textStyle="bold"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:id="@+id/layout_hail_threat"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="horizontal"
                                            android:visibility="gone"
                                            tools:visibility="visible">
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="@string/detail_source"
                                                android:textStyle="bold"/>
                                            <TextView
                                                android:id="@+id/detail_hail_threat"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textStyle="bold"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/layout_thunderstorm_damage"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:visibility="gone"
                                    tools:visibility="visible">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/thunderstorm"
                                        android:paddingEnd="8dp"
                                        android:paddingStart="0dp"
                                        android:contentDescription="@null"/>
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/detail_thunderstorm_damage"
                                        android:textStyle="bold"/>
                                    <TextView
                                        android:id="@+id/detail_thunderstorm_damage"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textStyle="bold"/>
                                </LinearLayout>

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/detail_instruction_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_instructions"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:paddingBottom="8dp" />

                        <TextView
                            android:id="@+id/detail_instructions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textIsSelectable="true"
                            android:typeface="monospace"
                            android:paddingBottom="16dp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/detail_raw_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/event_raw_scroller"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:padding="16dp"
            android:scrollbars="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/event_raw_json"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:typeface="monospace" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
